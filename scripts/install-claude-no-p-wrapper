#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'USAGE'
Usage: scripts/install-claude-no-p-wrapper [--bin-dir DIR] [--name NAME]

Installs a stable claude-no-p wrapper that runs this checkout via uv.

Options:
  --bin-dir DIR  Install directory. Defaults to ~/.local/bin
  --name NAME    Wrapper executable name. Defaults to claude-no-p
  -h, --help     Show this help.
USAGE
}

bin_dir="${HOME}/.local/bin"
name="claude-no-p"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --bin-dir)
      if [[ $# -lt 2 ]]; then
        printf 'error: --bin-dir requires a value\n' >&2
        exit 2
      fi
      bin_dir="$2"
      shift 2
      ;;
    --name)
      if [[ $# -lt 2 ]]; then
        printf 'error: --name requires a value\n' >&2
        exit 2
      fi
      name="$2"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      printf 'error: unknown argument: %s\n' "$1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

if ! command -v uv >/dev/null 2>&1; then
  printf 'error: uv is required but was not found on PATH\n' >&2
  exit 1
fi

script_dir="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
repo_root="$(CDPATH= cd -- "${script_dir}/.." && pwd)"
target="${bin_dir}/${name}"

mkdir -p -- "$bin_dir"

{
  printf '#!/usr/bin/env bash\n'
  printf 'set -euo pipefail\n'
  printf 'exec uv --directory %q run python -m poor_claude.cli "$@"\n' "$repo_root"
} > "$target"

chmod 0755 "$target"

printf 'Installed %s -> %s\n' "$name" "$target"
printf 'Wrapper target: uv --directory %s run python -m poor_claude.cli\n' "$repo_root"
